{
  "manifest_version": 3,
  "name": "Njia — eCitizen passport guide",
  "description": "Guides first-time Kenyan passport applicants through eCitizen, step by step, grounded in verified DIS facts. Reads page structure only — never what you type.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_title": "Njia — open the guide",
    "default_icon": {
      "16": "icons/njia-icon-16.png",
      "32": "icons/njia-icon-32.png",
      "48": "icons/njia-icon-48.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": [
        "https://dis.ecitizen.go.ke/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/njia-icon-16.png",
    "32": "icons/njia-icon-32.png",
    "48": "icons/njia-icon-48.png",
    "128": "icons/njia-icon-128.png"
  }
}
