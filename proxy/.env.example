# Copy to .env and fill in. NEVER commit .env (repo .gitignore covers it).
ANTHROPIC_API_KEY=
# Fast Sonnet-class model for snappy demo latency (see CLAUDE.md)
CLAUDE_MODEL=claude-3-7-sonnet-20250219
# Python used for knowledge retrieval (Adiel's RAG pipeline at the repo root).
# Point at a venv that has rank_bm25 installed, e.g. ../.venv/bin/python
PYTHON_BIN=python3
